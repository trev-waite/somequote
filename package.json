{
  "name": "somequote",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "preview": "turbo run preview",
    "db:migrate:local": "bun run --cwd apps/web db:migrate:local",
    "db:seed:local": "bun run --cwd apps/web db:seed:local",
    "content:verify-sources": "bun run --cwd packages/content verify-sources"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9"
  }
}
