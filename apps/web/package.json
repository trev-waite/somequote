{
  "name": "@somequote/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types --check && tsc -b",
    "types": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply somequote --local",
    "db:migrate:remote": "wrangler d1 migrations apply somequote --remote",
    "db:seed:local": "bun scripts/seed.ts --local",
    "db:seed:remote": "bun scripts/seed.ts --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@somequote/domain": "workspace:*",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@somequote/content": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
