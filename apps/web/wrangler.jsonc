{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "somequote",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-18",
  "upload_source_maps": true,
  // Serve only on the custom domain, where the zone's HTTPS redirect and WAF rules apply
  // (scripts/configure-zone.ts). workers.dev and version preview URLs would bypass both.
  "routes": [{ "pattern": "somequote.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*", "/404"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "somequote",
      "database_id": "063822de-f451-40ae-9770-58c3955441dd",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": {
    // Midnight in New York is 04:00 UTC during daylight time and 05:00 UTC during standard time.
    // Both triggers run every day; publishing is idempotent, so the one that is not midnight is a no-op.
    "crons": ["0 4 * * *", "0 5 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
